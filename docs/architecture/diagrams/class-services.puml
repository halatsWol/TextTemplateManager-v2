@startuml class-services
!include _style.iuml
title Services and platform (namespaces Services.*, Helpers)

package "Services.Platform" {
  interface IAppEnvironment {
    +IsPackaged : bool
    +DataDirectory : string
    +BackupDirectory : string
    +IsAutostartLaunch : bool
    +OpenedFile : string?
    +ReadRedirected(activation) : LaunchRequest
    +GetAutostartAsync() : AutostartState
    +SetAutostartAsync(on) : AutostartState
  }
  class "AppEnvironment.Packaged" as Packaged
  class "AppEnvironment.Unpackaged" as Unpackaged
  IAppEnvironment <|.. Packaged
  IAppEnvironment <|.. Unpackaged
  note bottom of Packaged
    LocalFolder of the package, StartupTask "TtmStartup",
    file and startup-task activation.
  end note
  note bottom of Unpackaged
    Dev run: own data folder ("TextTemplateManager 2 Dev"),
    --hidden stands in for a startup activation.
  end note

  class HotkeyListener {
    +HotkeyPressed (event)
    +Register(hotkey) : bool
  }
  class TrayIconService {
    +ShowBalloon(title, message)
    +SetUpdateReady(ready)
  }
  class UnexpectedErrorHandler {
    +HandleAsync(exception)
  }
  class LegacyApp <<static>> {
    +CloseRunningAsync(grace)
    +FindUninstaller()
    +UninstallAsync(timeout)
  }
  class LegacyAutostart <<static>> {
    +Read() : LegacyAutostartState?
    +CarryOverAsync(legacy, environment, settings)
  }

  interface IConnectorDataSource {
    +AppVersion
    +PasteModes()
    +Tree()
    +Template(id, mode)
    +CreateTemplateAsync(content, name)
  }
  class BrowserConnector {
    +{static} ProtocolVersion = 2
    +Start(port, token) / Stop()
    +Busy : bool
    -AcceptLoopAsync()
    -RouteAsync(request)
  }
  class AppConnectorData {
    +Rebuild()  (snapshot, UI thread)
  }
  IConnectorDataSource <|.. AppConnectorData
  BrowserConnector --> IConnectorDataSource
}

package "Services.Pasting" {
  class PasteService <<static>> {
    +HandlePaste(content, mode)
    +CopyToClipboardAsync(content, mode)
    +RenderForMode(content, mode)
    -SnapshotClipboardAsync()
    -BuildFormatsForMode(html, text, mode)
    -RestoreClipboardAsync(snapshot)
  }
}

package "Services.Updates" {
  class UpdateService {
    +Status : UpdateStatus
    +Policy : UpdatePolicy
    +Changed (event)
    +Start()
    +EvaluateStartup() : StartupUpdateResult
    +CheckAsync(userInitiated)
    +DownloadAsync(window, userInitiated)
    +SwitchAsync(idle, restart) : string?
    +IdleInstallAllowed(userSetting)
    +KeepUpdatingDespiteStorePolicy : bool
    +CheckAutomatically : bool
    +InstallOnQuit : bool
    +ChecksAutomatically : bool
    +RefreshPolicyForSwitch() : bool
  }
  interface IUpdateSource {
    +CheckAsync() : UpdateOffer?
    +CanDownloadSilently : bool
    +DownloadAsync(offer, progress)
    +RequestDownloadAsync(offer, window, progress)
    +DownloadDespitePolicyAsync(offer, progress)
  }
  class StoreUpdateSource
  class FileUpdateSource
  IUpdateSource <|.. StoreUpdateSource
  IUpdateSource <|.. FileUpdateSource
  note bottom of StoreUpdateSource
    StoreContext; despite the Store
    policy: winget (msstore).
  end note
  note bottom of FileUpdateSource
    Test source for sideloaded builds:
    .msix files in TTM_UPDATE_SOURCE.
  end note
  interface IPackageSwitcher {
    +RunningVersion
    +IsStaged(version)
    +RegisterRestart(args) / UnregisterRestart()
    +StartWatchdog(after)
    +SwitchAsync() : string?
  }
  class PackageSwitcher
  IPackageSwitcher <|.. PackageSwitcher
  class UpdatePolicy <<record>> {
    +Mode : InAppUpdatesMode
    +AllowDespiteStorePolicy
    +StoreBlocksAutomaticUpdates
    +IdleInstallForced : bool?
    +AutomaticUpdatesForced : bool?
    +{static} Read()
  }
  class UpdateAttempt <<record>> {
    +TargetVersion / Attempts
    +Evaluate(running)
  }
  class UpdateLog
  class IdleInstall <<static>> {
    +ShouldInstall(IdleState)
    +UserIdleTime()
  }
  UpdateService --> IUpdateSource
  UpdateService --> IPackageSwitcher
  UpdateService ..> UpdatePolicy
  UpdateService ..> UpdateAttempt : update-attempt.json
  UpdateService --> UpdateLog : update.log
}

package "Helpers" {
  class WindowHelper <<static>> {
    +CaptureTargetContext()
    +ForceWindowToFront(hwnd)
    +SendKeys(...) / ResetModifiers()
    +OnSessionEnd(hwnd, query, end)
    +PumpMessagesUntil(done, timeout)
  }
  class VariableHelper <<static>>
  class HtmlUtils <<static>>
  class PanelHtml <<static>>
  class HtmlToRtfHelper <<static>>
  class HtmlToMarkdown <<static>>
  class HtmlSanitizer <<static>>
}

PasteService ..> WindowHelper
PasteService ..> VariableHelper
PasteService ..> HtmlUtils
PasteService ..> PanelHtml
PasteService ..> HtmlToRtfHelper
PasteService ..> HtmlToMarkdown
AppConnectorData ..> PasteService : RenderForMode
AppConnectorData ..> HtmlSanitizer : created and served content
LegacyAutostart ..> IAppEnvironment
@enduml
