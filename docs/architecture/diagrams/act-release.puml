@startuml act-release
!include _style.iuml
title Release workflow (.github/workflows/release.yml)

|package (windows-latest)|
start
if (workflow_dispatch with\n"Check Store access"?) then (yes)
  |store-access|
  :build/Store-Api.ps1 -Check\n(sign-in, read the app and the pending\npackages; no build);
  stop
elseif (workflow_dispatch with\n"Commit the pending Store submission"?) then (yes)
  |store-commit (environment store-release)|
  :manual approval;
  :Store-Api.ps1 -Check -Commit\n(certification follows);
  |publish-when-live|
  :start publish-when-live.yml\n(newest draft release);
  stop
endif
|package (windows-latest)|
:tag vX.Y.Z pushed\n(or workflow_dispatch with a version);
:version = tag without "v"; must be X.Y.Z;
if (tag?) then (yes)
  :read the annotated tag message:\n"publish: none" / "draft" / "store" (default);
endif
:setup .NET 8 + 10;
:tests/run-tests.ps1;
:build/Build-Release.ps1\n-> x64 .msixupload (StoreBuild), Manual.pdf, AdminManual.pdf;
:build/Release-Notes.ps1\n-> GitHub notes (releases/vX.Y.Z/en-US/release.md\n   + generated changelog), store-listing/<language>/\n   (every field + screenshots; limits or fail);
:upload artifacts;
if (tag?) then (yes)
  :gh release create --draft (PDFs only, no .exe);
  |microsoft-store (environment store-release)|
  if (draft or store?) then (yes)
    :manual approval;
    :Store-Api.ps1 -Check\n(secrets, sign-in, access to the app);
    :Store-Api.ps1 -Submit\n(new submission: package, every listing's\ntexts and screenshots, new languages as\nnew listings; ZIP to the upload URL in blocks);
    if (store?) then (yes)
      :Store-Api.ps1 -Commit\n(certification follows);
      |publish-when-live|
      :start publish-when-live.yml;
      :every 10 min: version live in the\nStore catalog? then publish the release\n(5.5 h per run, next run, up to 7 days);
    else (draft)
      :left uncommitted: check, then commit\nwith the manual run;
    endif
  endif
endif
stop
@enduml
