@startuml act-connector-request
!include _style.iuml
title BrowserConnector: one request (thread pool, 10 s per connection)

start
:AcceptTcpClientAsync on 127.0.0.1:port;
:read headers (max 64 KB) and body (max 1 MB, UTF-8);
if (method OPTIONS?) then (yes)
  :204, CORS echoed for extension origins only;
  stop
endif
if (Origin set and not chrome-/moz-/safari-web-extension?) then (yes)
  :403 forbidden origin;
  stop
endif
if (x-ttm-token matches? (constant-time compare)) then (no)
  :401 unauthorized;
  stop
endif
if (Busy (guided tour runs)?) then (yes)
  :503 busy;
  stop
endif
:protocol = 3 when x-ttm-protocol asks for 3 or more, else 2;
switch (path)
case (/ping)
  :app, version, the protocol;
case (/pastemodes)
  :modes with labels;
case (/tree)
  :AppConnectorData snapshot\n(rebuilt on the UI thread after TreeChanged / DataSaved)\nv2: without the language fields;
case (GET /template?id=&mode=)
  :v3: the tab for lang= / langId= (404 when not pasted);
  :HtmlSanitizer.Sanitize(content)\n-> PasteService.RenderForMode(mode);
case (POST /template)
  :v3: languages checked first (400);
  :marshal to the UI thread:\nsanitize, unique title, add to the local root, save;
case (POST /template/language (v3))
  :marshal to the UI thread: 404 / 403 read-only / 409 sync file missing;
  :MainPage: flush the editor; 409 with unsaved edits;
  :ConnectorLanguages.Write (409 for the default), editor reload, save;
case ()
  :404;
endswitch
:JSON response;
stop
@enduml
