<Page
    x:Class="TextTemplateManager.BackupsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextTemplateManager">

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
    <StackPanel Spacing="25" Padding="20">
        <TextBlock x:Uid="BackupsPage_Title" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="BackupsPage_AutomaticHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock x:Uid="BackupsPage_AutomaticText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="FolderText" VerticalAlignment="Center" IsTextSelectionEnabled="True"
                           TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                <Button x:Uid="BackupsPage_OpenFolderButton" Click="OpenFolder_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                <Button x:Name="ExportButton" x:Uid="BackupsPage_ExportButton" Click="ExportBackup_Click"/>
                <TextBlock x:Uid="BackupsPage_ExportText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <InfoBar x:Name="ExportInfo" IsOpen="False" IsClosable="True"/>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,5"/>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="BackupsPage_RestoreHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock x:Uid="BackupsPage_RestoreText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <ListView x:Name="BackupList" x:Uid="BackupsPage_BackupList" SelectionMode="Single" MaxHeight="320" SelectionChanged="BackupList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BackupRow">
                        <StackPanel Padding="0,6" Opacity="{x:Bind Opacity}" AutomationProperties.Name="{x:Bind Title}">
                            <TextBlock Text="{x:Bind Title}"/>
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" x:Uid="BackupsPage_EmptyText" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}"/>

            <TextBlock x:Uid="BackupsPage_RestorePartsLabel" Margin="0,8,0,0"/>
            <CheckBox x:Name="LocalBox" x:Uid="BackupsPage_LocalBox" IsChecked="True" Click="Parts_Click"/>
            <CheckBox x:Name="SettingsBox" x:Uid="BackupsPage_SettingsBox" IsChecked="True" Click="Parts_Click"/>
            <CheckBox x:Name="SyncBox" x:Uid="BackupsPage_SyncBox" IsChecked="True" Click="Sync_Click"/>
            <StackPanel Margin="28,0,0,0">
                <CheckBox x:Name="SyncSettingsBox" x:Uid="BackupsPage_SyncSettingsBox" IsChecked="True" Click="SyncPart_Click"/>
                <CheckBox x:Name="SyncedFoldersBox" x:Uid="BackupsPage_SyncedFoldersBox" IsChecked="False" Click="SyncPart_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                <Button x:Name="RestoreButton" x:Uid="BackupsPage_RestoreButton" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"
                        Click="Restore_Click"/>
                <Button x:Name="RestoreFileButton" x:Uid="BackupsPage_RestoreFileButton" Click="RestoreFromFile_Click"/>
                <Button x:Name="ImportV1Button" x:Uid="BackupsPage_ImportV1Button" Click="ImportV1_Click" Visibility="Collapsed"/>
            </StackPanel>
            <InfoBar x:Name="RestoreInfo" IsOpen="False" IsClosable="True" Severity="Error"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
