<Page
    x:Class="TextTemplateManager.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:TextTemplateManager.Common">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
    <StackPanel Spacing="25" Padding="20">
        <TextBlock x:Uid="GeneralPage_Title" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Spacing="10">
            <TextBlock x:Uid="GeneralPage_QuickPasteHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="GeneralPage_HotkeyLabel"/>
                <TextBlock x:Uid="GeneralPage_HotkeyText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Grid ColumnSpacing="10" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HotkeyTextBox" x:Uid="GeneralPage_HotkeyBox"
                             IsReadOnly="True"
                             GotFocus="HotkeyTextBox_GotFocus"
                             LostFocus="HotkeyTextBox_LostFocus"
                             KeyDown="HotkeyTextBox_KeyDown"
                             KeyUp="HotkeyTextBox_KeyUp"/>
                    <Button x:Uid="GeneralPage_ClearHotkeyButton" Grid.Column="1" Click="ClearHotkey_Click"/>
                </Grid>
                <InfoBar x:Name="HotkeyUnavailableInfo" x:Uid="GeneralPage_HotkeyUnavailableInfo"
                         Severity="Warning"
                         IsClosable="False"
                         IsOpen="False"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock x:Uid="GeneralPage_PasteModeLabel"/>
                <TextBlock x:Uid="GeneralPage_PasteModeText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ComboBox x:Name="PasteModeCombo" x:Uid="GeneralPage_PasteModeCombo"
                          MinWidth="200"
                          SelectedItem="{x:Bind ViewModel.DefaultPasteMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PasteModeLabelConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,5"/>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="GeneralPage_StartupHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <StackPanel Spacing="2">
                <ToggleSwitch x:Name="StartupToggle" x:Uid="GeneralPage_StartupToggle"
                              Toggled="RunAtStartup_Toggled"/>
                <TextBlock x:Name="StartupNote"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ToggleSwitch x:Name="StartHiddenToggle" x:Uid="GeneralPage_StartHiddenToggle"
                              Margin="24,0,0,0"
                              Toggled="StartHidden_Toggled"/>
                <TextBlock x:Uid="GeneralPage_StartHiddenText"
                           TextWrapping="Wrap"
                           Margin="24,0,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,5"/>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="GeneralPage_EditingHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <StackPanel Spacing="2">
                <ToggleSwitch x:Name="AutosaveToggle" x:Uid="GeneralPage_AutosaveToggle"
                              IsOn="{x:Bind ViewModel.Autosave, Mode=TwoWay}"/>
                <TextBlock x:Uid="GeneralPage_AutosaveText"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,5"/>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="GeneralPage_UpdatesHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <StackPanel Spacing="4">
                <TextBlock x:Name="UpdateVersionText"/>
                <TextBlock x:Name="UpdateStatusText"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Button x:Name="CheckUpdatesButton" x:Uid="GeneralPage_CheckUpdatesButton" Margin="0,4,0,0" Click="CheckUpdates_Click"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <ToggleSwitch x:Name="AutomaticUpdatesToggle" x:Uid="GeneralPage_AutomaticUpdatesToggle"
                              Toggled="AutomaticUpdates_Toggled"/>
                <TextBlock x:Uid="GeneralPage_AutomaticUpdatesText"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="StorePolicyNote"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="AutomaticUpdatesNote"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Spacing="2">
                <ToggleSwitch x:Name="IdleInstallToggle" x:Uid="GeneralPage_IdleInstallToggle"
                              Toggled="IdleInstall_Toggled"/>
                <TextBlock x:Uid="GeneralPage_IdleInstallText"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="IdleInstallNote"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,5"/>

        <StackPanel Spacing="10">
            <TextBlock x:Uid="GeneralPage_OtherHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>

            <StackPanel Spacing="2">
                <ToggleSwitch x:Name="HideCrossAreaWarningsToggle" x:Uid="GeneralPage_HideCrossAreaWarningsToggle"
                              IsOn="{x:Bind ViewModel.HideCrossAreaShortcutWarnings, Mode=TwoWay}"
                              Toggled="HideCrossAreaWarnings_Toggled"/>
                <TextBlock x:Uid="GeneralPage_HideCrossAreaWarningsText"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
