<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TextTemplateManager.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:TextTemplateManager.ViewModels"
    xmlns:helpers="using:TextTemplateManager.Helpers"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:appcontrols="using:TextTemplateManager.Controls"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <!-- Ctrl+F focuses the search box from anywhere in the window. -->
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="SearchAccelerator_Invoked"/>
        <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="SaveAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Compact tree rows -->
        <Style TargetType="TreeViewItem">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- FOLDER DETAILS -->
        <DataTemplate x:Key="FolderDetailTemplate">
            <Grid RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Uid="MainPage_FolderTemplateTitleBox"
                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5">
                    <FontIcon Glyph="&#xE8B7;" FontSize="80"/>
                    <TextBlock x:Uid="MainPage_FolderTemplateSelected" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- EMPTY -->
        <DataTemplate x:Key="EmptyDetailTemplate">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.3">
                <FontIcon Glyph="&#xE12B;" FontSize="80"/>
                <TextBlock x:Uid="MainPage_EmptyTemplateText" HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>


    </Page.Resources>

    <!-- Root grid stretches with the window so content reflows; the overlay Canvas below
         hosts floating panels. (A Canvas root measured children with infinite width, so the
         panes kept their width and were clipped instead of shrinking when the window narrowed.) -->
    <Grid>

        <!-- The guided tour, drawn on top of everything (only in the window showing the tour's sample data). First in
             the tree, so screen readers reach its card before the editor: a UI Automation search stops at a WebView2. -->
        <appcontrols:TutorialOverlay x:Name="Tour" Canvas.ZIndex="200"/>

        <!-- Main layout grid -->
        <Grid x:Name="MainGrid" PreviewKeyDown="MainGrid_PreviewKeyDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- MenuBar -->
                <RowDefinition Height="Auto"/>
                <!-- Update notice -->
                <RowDefinition Height="*"/>
                <!-- Main content -->
            </Grid.RowDefinitions>

            <!-- Menu Bar -->
            <MenuBar Grid.Row="0">
                <MenuBarItem x:Name="FileMenu" x:Uid="MainPage_FileMenu">
                    <MenuFlyoutItem x:Uid="MainPage_ImportItem" Icon="OpenFile" Click="Import_Click"/>
                    <MenuFlyoutItem x:Uid="MainPage_ExportItem" Text="{x:Bind ExportLabel(ViewModel.CanExportSelection), Mode=OneWay}" Icon="Save" Click="Export_Click"
                                    IsEnabled="{x:Bind ViewModel.CanExportSelection, Mode=OneWay}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="MainPage_SettingsItem" Icon="Setting" Click="OpenPreferences_Click"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="MainPage_ExitItem" Click="Exit_Click"/>
                </MenuBarItem>
                <MenuBarItem x:Name="HelpMenu" x:Uid="MainPage_HelpMenu">
                    <MenuFlyoutItem x:Uid="MainPage_ManualItem" Icon="Library" Click="OpenManual_Click"/>
                    <MenuFlyoutItem x:Uid="MainPage_TutorialItem" Click="StartTutorial_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE7BE;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="MainPage_WebsiteItem" Click="GoToWebsite_Click">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE774;"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="MainPage_AboutItem" Icon="Help" Click="About_Click"/>
                </MenuBarItem>
            </MenuBar>

            <!-- Top-right actions at the File-menu height: save indicator, Save + quick help. -->
            <StackPanel x:Name="TopRightActions" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="6" Margin="0,0,10,0">
                <!-- Transient "Saved" indicator; fades in on save, out after 3s (see MainPage.xaml.cs). -->
                <StackPanel x:Name="SaveNotification" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                    <TextBlock x:Uid="MainPage_SavedText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <!-- Autosave off: shown while the edited item has unsaved changes. -->
                <Button x:Name="SaveButton" x:Uid="MainPage_SaveButton" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" Padding="10,3"
                        Visibility="{x:Bind ViewModel.HasUnsavedChanges, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="12"/>
                        <TextBlock x:Uid="MainPage_SaveButtonText" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MainHelpButton" x:Uid="MainPage_HelpButton"
                        Content="&#xE897;" FontFamily="Segoe MDL2 Assets" Click="MainHelpButton_Click" Style="{StaticResource SubtleButtonStyle}"/>
            </StackPanel>

            <!-- In-app updates: downloading, ready (Restart to update), blocked by policy, failed. See MainPage.Updates.cs. -->
            <InfoBar x:Name="UpdateBar" x:Uid="MainPage_UpdateBar" Grid.Row="1" IsOpen="False" Margin="10,0,10,6" CloseButtonClick="UpdateBar_CloseButtonClick">
                <InfoBar.ActionButton>
                    <Button x:Name="UpdateBarAction" Click="UpdateBarAction_Click"/>
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Margin="0,0,0,8" Maximum="1"/>
                </InfoBar.Content>
            </InfoBar>

            <!-- Main Content Grid -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- Tree pane: opens at 300 (Width is hardcoded, so never persisted),
                         user-resizable via the splitter between 150 and 500. -->
                    <ColumnDefinition Width="300" MinWidth="150" MaxWidth="500"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane -->
                <Grid x:Name="LeftPane" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Buttons: add and delete on the left, expand/collapse all on the right -->
                    <Grid x:Name="TreeToolbar" Margin="10,10,10,5">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <!-- The tree's item icons (Symbol.Document / Symbol.Folder), as glyphs to match the other buttons' size. -->
                            <Button x:Name="AddTemplateButton" x:Uid="MainPage_AddTemplateButton" Content="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Click="AddTemplate_Click" IsEnabled="{x:Bind ViewModel.CanAddHere, Mode=OneWay}"/>
                            <Button x:Name="AddFolderButton" x:Uid="MainPage_AddFolderButton" Content="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Click="AddFolder_Click" IsEnabled="{x:Bind ViewModel.CanAddHere, Mode=OneWay}"/>
                            <Button x:Name="DeleteButton" x:Uid="MainPage_DeleteButton" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Click="DeleteItem_Click"
                                    IsEnabled="{x:Bind ViewModel.CanDeleteSelection, Mode=OneWay}"/>
                        </StackPanel>
                        <!-- Chevrons as on the tree's folders: right = collapsed, down = expanded. Smaller glyphs; the
                             buttons keep the toolbar's size (full row height, padding making up the width). -->
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button x:Name="CollapseAllButton" x:Uid="MainPage_CollapseAllButton" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                    Padding="13,0,12,0" VerticalAlignment="Stretch" Click="CollapseAll_Click"/>
                            <Button x:Name="ExpandAllButton" x:Uid="MainPage_ExpandAllButton" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                    Padding="13,0,12,0" VerticalAlignment="Stretch" Click="ExpandAll_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Search -->
                    <Grid Grid.Row="1" Margin="10,5" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="SearchBox" x:Uid="MainPage_SearchBox"
                                        QueryIcon="Find"
                                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <appcontrols:SearchOptionsButton x:Name="SearchOptions" Grid.Column="1"/>
                    </Grid>

                    <!-- TreeView -->
                    <!-- KeyDown is attached in code with handledEventsToo so Enter/Space are seen
                         even after the TreeView marks them handled (see the constructor), and so are
                         DragOver/Drop. Items are dragged by their own CanDrag and dropped by those
                         handlers; the TreeView's built-in reorder would move them inside the view
                         collections only. The transparent background makes the space below the rows a
                         drop target too. -->
                    <TreeView x:Name="ItemTreeView"
                              Grid.Row="2"
                              Background="Transparent"
                              SelectionMode="Single"
                              CanDragItems="False"
                              CanReorderItems="False"
                              AllowDrop="True"
                              ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}"
                              ItemInvoked="ItemTreeView_ItemInvoked"
                              Tapped="ItemTreeView_Tapped"
                              SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:TreeNode">
                                <TreeViewItem ItemsSource="{x:Bind Children}"
                                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              HorizontalContentAlignment="Stretch"
                                              CanDrag="True"
                                              AllowDrop="True"
                                              DragEnter="TreeItem_DragEnter"
                                              DragStarting="TreeItem_DragStarting"
                                              DropCompleted="TreeItem_DropCompleted"
                                              RightTapped="Tree_RightTapped"
                                              DataContextChanged="TreeItem_DataContextChanged">
                                    <!-- Background=Transparent so the whole row is hit-testable, not just the text. -->
                                    <Grid Background="Transparent">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid VerticalAlignment="Center" Width="20" Height="20">
                                            <SymbolIcon Symbol="{x:Bind Icon}"/>
                                            <Border Visibility="{x:Bind Item.IsSyncRoot, Converter={StaticResource BoolToVis}}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" CornerRadius="5">
                                                <FontIcon Glyph="&#xE895;" FontSize="9"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}" VerticalAlignment="Center"/>
                                        <FontIcon x:Uid="MainPage_SyncMissingIcon" Glyph="&#xE7BA;" FontSize="12" Foreground="#E6A700" VerticalAlignment="Center"
                                                  Visibility="{x:Bind Item.SyncFileMissing, Converter={StaticResource BoolToVis}}"/>
                                        <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#E6A700" VerticalAlignment="Center"
                                                  Visibility="{x:Bind Item.HasSyncWriteProblem, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                  AutomationProperties.Name="{x:Bind Item.SyncWriteProblem, Mode=OneWay}"
                                                  ToolTipService.ToolTip="{x:Bind Item.SyncWriteProblem, Mode=OneWay}"/>
                                    </StackPanel>
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>

                <!-- Splitter: the gripper glyph shows you can click & drag here to resize the panes.
                     The glyph is IsHitTestVisible=False so drags pass through to the GridSplitter, which
                     stays a direct child of this Grid (column 1) so it still resizes the outer columns. -->
                <controls:GridSplitter x:Uid="MainPage_Splitter" Grid.Column="1" Width="12" Background="Transparent" IsThumbVisible="False"/>
                <FontIcon Grid.Column="1" Glyph="&#xE784;" FontSize="14" FontFamily="Segoe MDL2 Assets"
                          IsHitTestVisible="False"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Right Pane: persistent editor + placeholders (WebView2 must not live in a DataTemplate) -->
                <Grid Grid.Column="2" Padding="24">

                    <!-- TEMPLATE: title + WebView2 editor + metadata -->
                    <Grid x:Name="TemplatePanel"
                          RowSpacing="12"
                          DataContext="{x:Bind ViewModel.EditedTemplate, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsEditorEnabled, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="TemplateTitleBox" x:Uid="MainPage_TitleBox"
                                 IsReadOnly="{x:Bind ViewModel.IsSelectedReadOnly, Mode=OneWay}"
                                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Border x:Name="EditorCard" Grid.Row="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="180"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <appcontrols:TemplateEditor x:Name="Editor"/>
                        </Border>

                        <StackPanel x:Name="TemplateMetaPanel" Grid.Row="2" Spacing="10">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                    <TextBlock x:Uid="MainPage_SingleKeyLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SingleKeyBox" x:Uid="MainPage_SingleKeyBox" Width="50"
                                             CharacterCasing="Upper"
                                             MaxLength="1"
                                             IsReadOnly="{x:Bind ViewModel.IsSelectedReadOnly, Mode=OneWay}"
                                             TextChanged="Shortcut_TextChanged"
                                             Text="{Binding SingleKeyShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalContentAlignment="Center"
                                             Padding="4"
                                             CornerRadius="4"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                    <TextBlock x:Uid="MainPage_MultiKeyLabel" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MultiKeyBox" x:Uid="MainPage_MultiKeyBox" Width="250"
                                             MaxLength="20"
                                             CharacterCasing="Upper"
                                             IsReadOnly="{x:Bind ViewModel.IsSelectedReadOnly, Mode=OneWay}"
                                             TextChanged="Shortcut_TextChanged"
                                             Text="{Binding MultiKeyShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalContentAlignment="Center"
                                             Padding="4"
                                             CornerRadius="4"/>
                                </StackPanel>
                            </Grid>

                            <TextBox x:Name="TagsBox" x:Uid="MainPage_TagsBox"
                                     IsReadOnly="{x:Bind ViewModel.IsSelectedReadOnly, Mode=OneWay}"
                                     Text="{Binding TagsCsv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <ComboBox x:Name="PasteModeBox" x:Uid="MainPage_PasteModeBox"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="{x:Bind ViewModel.IsSelectedEditable, Mode=OneWay}"
                                      ItemsSource="{Binding DataContext.ViewModel.PasteModes, ElementName=ItemTreeView}"
                                      SelectedItem="{Binding DefaultPasteMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource PasteModeLabelConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- FOLDER placeholder -->
                    <Grid x:Name="FolderPanel"
                          RowSpacing="20"
                          DataContext="{x:Bind ViewModel.EditedItem, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IsFolderSelected, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="FolderTitleBox" x:Uid="MainPage_FolderTitleBox"
                                 Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5">
                            <FontIcon Glyph="&#xE8B7;" FontSize="80"/>
                            <TextBlock x:Uid="MainPage_FolderSelected" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- EMPTY placeholder -->
                    <StackPanel x:Name="EmptyPanel"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.3"
                                Visibility="{x:Bind ViewModel.IsNoSelection, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <FontIcon Glyph="&#xE12B;" FontSize="80"/>
                        <TextBlock x:Uid="MainPage_EmptyText" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- Overlay layer for floating draggable panels. No Background, so empty areas are
             hit-test transparent and pointer events pass through to the main grid below. -->
        <Canvas x:Name="RootCanvas">

            <appcontrols:ConflictPanel x:Name="ConflictPanel" Canvas.Left="0" Canvas.Top="0"/>
        </Canvas>

        <!-- Settings, shown in place over the main content. -->
        <appcontrols:SettingsView x:Name="Settings"/>

        <TeachingTip x:Name="MainHelpTip" x:Uid="MainPage_HelpTip" Target="{x:Bind MainHelpButton}"
                     PreferredPlacement="BottomLeft" IsLightDismissEnabled="True"
                     ShouldConstrainToRootBounds="False">
            <TeachingTip.Content>
                <Grid MaxWidth="360" Margin="0,4" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="🗂️" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="MainPage_GuideOrganizeLabel" FontWeight="SemiBold"/><Run x:Uid="MainPage_GuideOrganizeText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="🔄" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="MainPage_GuideSyncLabel" FontWeight="SemiBold"/><Run x:Uid="MainPage_GuideSyncText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="⌨️" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="MainPage_GuideShortcutsLabel" FontWeight="SemiBold"/><Run x:Uid="MainPage_GuideShortcutsText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="⚠" VerticalAlignment="Top" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="MainPage_GuideConflictsLabel" FontWeight="SemiBold"/><Run x:Uid="MainPage_GuideConflictsText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="🖱️" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="MainPage_GuideRightClickLabel" FontWeight="SemiBold"/><Run x:Uid="MainPage_GuideRightClickText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="🔍" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="MainPage_GuideSearchLabel" FontWeight="SemiBold"/><Run x:Uid="MainPage_GuideSearchText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="🎨" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="MainPage_GuideEditorLabel" FontWeight="SemiBold"/><Run x:Uid="MainPage_GuideEditorText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="⚡" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="MainPage_GuideQuickPasteLabel" FontWeight="SemiBold"/><Run x:Uid="MainPage_GuideQuickPasteText"/>
                    </TextBlock>
                </Grid>
            </TeachingTip.Content>
        </TeachingTip>

        <!-- After a skipped tour: where it can be started again. -->
        <TeachingTip x:Name="TourHintTip" x:Uid="MainPage_TourHintTip" Target="{x:Bind HelpMenu}" PreferredPlacement="Bottom" IsLightDismissEnabled="True"/>
    </Grid>
</Page>
