<Page
    x:Class="TextTemplateManager.SupportSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
    <StackPanel Spacing="25" Padding="20">
        <TextBlock Text="Support" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Spacing="8">
            <TextBlock Text="Help" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Answers to common questions (updates, Quick Paste, moving to another PC) are on the website, together with the manuals."/>
            <HyperlinkButton x:Name="HelpLink" Content="Help &amp; troubleshooting" Padding="0"/>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,5"/>

        <StackPanel Spacing="8">
            <TextBlock Text="Report a problem" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Describe it as exactly as you can: when it happened (date and time), what you did right before, step by step, what you expected and what happened instead, with the exact text of any message. The e-mail and the GitHub form ask for all of it; the e-mail already has the app and Windows version."/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Report by e-mail" Style="{StaticResource AccentButtonStyle}" Click="ProblemMail_Click"/>
                <Button Content="Report on GitHub" Click="ProblemGitHub_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="Suggest a feature" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="What would you like to get done, how do you do it today, and how could it work?"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Suggest by e-mail" Click="FeatureMail_Click"/>
                <Button Content="Suggest on GitHub" Click="FeatureGitHub_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Text="Report a security vulnerability" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Report it privately, never as a public issue. Only the developer sees the report until a fix is out."/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Report by e-mail" Click="SecurityMail_Click"
                        AutomationProperties.Name="Report a security vulnerability by e-mail"/>
                <Button Content="Report privately on GitHub" Click="SecurityGitHub_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="GitHub needs a GitHub account, and issues there are public: don't post private text. E-mail works without an account."/>
            <TextBlock x:Name="MailHint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
