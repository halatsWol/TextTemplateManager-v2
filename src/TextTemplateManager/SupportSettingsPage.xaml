<Page
    x:Class="TextTemplateManager.SupportSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TextTemplateManager.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
    <StackPanel Spacing="25" Padding="20">
        <TextBlock x:Uid="SupportPage_Title" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="SupportPage_HelpHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock x:Uid="SupportPage_HelpText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <HyperlinkButton x:Name="HelpLink" x:Uid="SupportPage_HelpLink" Padding="0"/>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="SupportPage_LogsHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock x:Uid="SupportPage_LogsText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ExportLogsButton" x:Uid="SupportPage_ExportLogsButton" Click="ExportLogs_Click"/>
                <ProgressRing x:Name="ExportLogsProgress" IsActive="False" Width="20" Height="20"/>
                <TextBlock x:Name="ExportLogsStatus" x:Uid="SupportPage_ExportLogsStatus" VerticalAlignment="Center" Visibility="Collapsed"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <InfoBar x:Name="ExportLogsInfo" IsOpen="False" IsClosable="True">
                <InfoBar.ActionButton>
                    <Button x:Name="ShowLogsButton" x:Uid="SupportPage_ShowLogsButton" Click="ShowLogs_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,5"/>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="SupportPage_ProblemHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock x:Uid="SupportPage_ProblemText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="SupportPage_ProblemMailButton" Style="{StaticResource AccentButtonStyle}" Click="ProblemMail_Click"/>
                <Button x:Uid="SupportPage_ProblemGitHubButton" Click="ProblemGitHub_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="SupportPage_FeatureHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock x:Uid="SupportPage_FeatureText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="SupportPage_FeatureMailButton" Click="FeatureMail_Click"/>
                <Button x:Uid="SupportPage_FeatureGitHubButton" Click="FeatureGitHub_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="SupportPage_SecurityHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock x:Uid="SupportPage_SecurityText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="SupportPage_SecurityMailButton" Click="SecurityMail_Click"/>
                <Button x:Uid="SupportPage_SecurityGitHubButton" Click="SecurityGitHub_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock x:Uid="SupportPage_GitHubHint" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <controls:MailFallbackHint x:Name="MailHint"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
