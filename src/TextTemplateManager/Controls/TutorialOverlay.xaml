<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TextTemplateManager.Controls.TutorialOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed" IsTabStop="False" UseSystemFocusVisuals="False" PreviewKeyDown="Overlay_PreviewKeyDown">

    <!-- The transparent background takes every click, the cutout included: during the tour only the card works. -->
    <Grid x:Name="Root" Background="Transparent" KeyDown="Root_KeyDown" PointerPressed="Root_PointerPressed">
        <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False"/>
        <!-- Shown for one step on top of the dimming (e.g. a picture of an open menu); never takes input. -->
        <Grid x:Name="Extra" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
        <Border x:Name="Highlight" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2"
                CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>

        <Border x:Name="Card" x:Uid="Tour_Card" Width="360" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,12,16,14" TabFocusNavigation="Cycle">
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock x:Name="Counter" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="CloseButton" x:Uid="Tour_CloseButton" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Padding="6"
                            Click="Skip_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="StepTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="StepText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                <Grid Margin="0,6,0,0">
                    <HyperlinkButton x:Name="SkipButton" x:Uid="Tour_SkipButton" Padding="0" Click="Skip_Click"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="BackButton" x:Uid="Tour_BackButton" Click="Back_Click"/>
                        <Button x:Name="NextButton" x:Uid="Tour_NextButton" Style="{StaticResource AccentButtonStyle}" Click="Next_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
