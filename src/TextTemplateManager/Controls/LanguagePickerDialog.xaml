<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TextTemplateManager.Controls.LanguagePickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:translation="using:TextTemplateManager.Services.Translation"
    xmlns:local="using:TextTemplateManager.Controls"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <ContentDialog.Resources>
        <CollectionViewSource x:Name="GroupedLanguages" IsSourceGrouped="True"/>
    </ContentDialog.Resources>

    <StackPanel Spacing="8" Width="360">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBox x:Name="FilterBox" x:Uid="LanguagePicker_FilterBox"
                 TextChanged="FilterBox_TextChanged" KeyDown="FilterBox_KeyDown"/>
        <ListView x:Name="LanguageList" x:Uid="LanguagePicker_List" Height="320"
                  SelectionMode="Single"
                  ItemsSource="{x:Bind GroupedLanguages.View, Mode=OneWay}"
                  SelectionChanged="LanguageList_SelectionChanged"
                  DoubleTapped="LanguageList_DoubleTapped"
                  KeyDown="LanguageList_KeyDown">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="local:LanguageGroup">
                            <TextBlock Text="{x:Bind Title}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="translation:LanguageChoice">
                    <Grid ColumnSpacing="8" AutomationProperties.Name="{x:Bind Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Code}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
