<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TextTemplateManager.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <!-- Shown in place over the main content. The NavigationView back arrow (top-left) closes it. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Visible"
                        IsBackEnabled="True"
                        BackRequested="Nav_BackRequested"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General" Icon="Setting"/>
                <NavigationViewItem Content="Integrations" Tag="Integrations" Icon="Link"/>
                <NavigationViewItem Content="Sync" Tag="Sync" Icon="Sync"/>
            </NavigationView.MenuItems>
            <Frame x:Name="PageFrame" Padding="20"/>
        </NavigationView>
    </Grid>
</UserControl>
