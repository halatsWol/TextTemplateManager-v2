<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TextTemplateManager.Controls.ConflictPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextTemplateManager.Controls"
    xmlns:viewmodels="using:TextTemplateManager.ViewModels"
    Visibility="Collapsed">

    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="Panel" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <!-- Floating, draggable: the page puts it on its overlay canvas. -->
    <Border x:Name="Panel"
            Width="360"
            MaxHeight="260"
            Background="#FFFDF3D6"
            BorderBrush="#FFE6B800"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10"
            PointerPressed="Panel_PointerPressed"
            PointerReleased="Panel_PointerReleased"
            PointerMoved="Panel_PointerMoved">

        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>

        <StackPanel>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="⚠ Shortcut Conflicts" FontWeight="Bold" VerticalAlignment="Center"/>
                <!-- Dismiss: only shown for purely cross-area (sync↔local) notes; same-area
                     conflicts must be resolved, so the panel stays put for those. -->
                <Button x:Name="DismissButton" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="4" MinWidth="0" Background="Transparent" BorderThickness="0"
                        Click="Dismiss_Click" ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Button>
            </Grid>

            <ScrollViewer MaxHeight="200">
                <ItemsControl x:Name="LineList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ConflictLine">
                            <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap"
                                       FontWeight="{x:Bind local:ConflictPanel.WeightOf(Kind)}"
                                       Margin="{x:Bind local:ConflictPanel.MarginOf(Kind)}"
                                       Foreground="{x:Bind local:ConflictPanel.ForegroundOf(Kind)}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
