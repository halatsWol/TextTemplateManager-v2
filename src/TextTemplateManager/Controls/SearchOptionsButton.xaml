<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TextTemplateManager.Controls.SearchOptionsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button x:Name="OptionsButton" x:Uid="SearchOptions_Button"
            Style="{StaticResource SubtleButtonStyle}"
            VerticalAlignment="Stretch"
            Padding="8,0">
        <Grid>
            <FontIcon Glyph="&#xE71C;" FontSize="14"/>
            <!-- Shown while the search is widened, so the narrower default is never mistaken for it. -->
            <Ellipse x:Name="ActiveDot"
                     Width="6" Height="6"
                     Margin="0,-3,-5,0"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Visibility="Collapsed"/>
        </Grid>
        <Button.Flyout>
            <!-- Kept inside the window: a separate popup window would deactivate Quick Paste. -->
            <MenuFlyout x:Name="Menu" Placement="BottomEdgeAlignedRight" ShouldConstrainToRootBounds="True">
                <!-- In-window, the default acrylic background lets the tree show through. -->
                <MenuFlyout.MenuFlyoutPresenterStyle>
                    <Style TargetType="MenuFlyoutPresenter">
                        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"/>
                    </Style>
                </MenuFlyout.MenuFlyoutPresenterStyle>
                <ToggleMenuFlyoutItem x:Name="ContentItem" x:Uid="SearchOptions_ContentItem"/>
                <ToggleMenuFlyoutItem x:Name="StrictItem" x:Uid="SearchOptions_StrictItem"/>
            </MenuFlyout>
        </Button.Flyout>
    </Button>
</UserControl>
