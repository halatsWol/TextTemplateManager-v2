<Page
    x:Class="TextTemplateManager.SyncSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:TextTemplateManager.Models"
    xmlns:helpers="using:TextTemplateManager.Helpers">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title + separator setting, with the help button pinned top-right -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="10">
                <TextBlock x:Uid="SyncPage_Title" Style="{StaticResource TitleTextBlockStyle}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="SyncPage_SeparatorLabel" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <!-- Value is mapped by index: 0='-', 1='.', 2=none (""). See the code-behind. -->
                    <ComboBox x:Name="SeparatorBox" x:Uid="SyncPage_SeparatorBox" Width="96"
                              SelectionChanged="Separator_SelectionChanged">
                        <ComboBoxItem Content="-"/>
                        <ComboBoxItem Content="."/>
                        <ComboBoxItem>
                            <!-- Right padding keeps the italic slant of "none" from clipping when selected. -->
                            <TextBlock x:Uid="SyncPage_SeparatorNone" FontStyle="Italic" Padding="0,0,4,0"/>
                        </ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
            <Button x:Name="SyncHelpButton" x:Uid="SyncPage_HelpButton" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                    Click="SyncHelpButton_Click" Style="{StaticResource SubtleButtonStyle}">
                <FontIcon Glyph="&#xE897;"/>
            </Button>
        </Grid>

        <!-- Toolbar: add existing / create new -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Uid="SyncPage_AddButton" Click="AddExisting_Click"/>
            <Button x:Uid="SyncPage_CreateButton" Click="CreateNew_Click"/>
        </StackPanel>

        <TeachingTip x:Name="SyncHelpTip" x:Uid="SyncPage_HelpTip" Target="{x:Bind SyncHelpButton}"
                     PreferredPlacement="BottomLeft" IsLightDismissEnabled="True">
            <TeachingTip.Content>
                <Grid MaxWidth="360" Margin="0,4" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="➕" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="SyncPage_GuideAddLabel" FontWeight="SemiBold"/><Run x:Uid="SyncPage_GuideAddText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="✅" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="SyncPage_GuideActiveLabel" FontWeight="SemiBold"/><Run x:Uid="SyncPage_GuideActiveText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="💾" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="SyncPage_GuideSaveLabel" FontWeight="SemiBold"/><Run x:Uid="SyncPage_GuideSaveText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="🏷️" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="SyncPage_GuideNameLabel" FontWeight="SemiBold"/><Run x:Uid="SyncPage_GuideNameText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="↕️" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="SyncPage_GuideOrderLabel" FontWeight="SemiBold"/><Run x:Uid="SyncPage_GuideOrderText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="⚠" VerticalAlignment="Top" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="SyncPage_GuideMissingLabel" FontWeight="SemiBold"/><Run x:Uid="SyncPage_GuideMissingText"/>
                    </TextBlock>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="🔤" VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" FontSize="13">
                        <Run x:Uid="SyncPage_GuideSeparatorLabel" FontWeight="SemiBold"/><Run x:Uid="SyncPage_GuideSeparatorText"/>
                    </TextBlock>
                </Grid>
            </TeachingTip.Content>
        </TeachingTip>

        <!-- Column headers -->
        <Grid Grid.Row="2" ColumnSpacing="8" Padding="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="SyncPage_ActiveColumn" Grid.Column="0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Uid="SyncPage_SaveColumn" Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Uid="SyncPage_NameColumn" Grid.Column="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Uid="SyncPage_PrefixColumn" Grid.Column="3" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Uid="SyncPage_FileColumn" Grid.Column="4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- Source list -->
        <ListView Grid.Row="3" x:Name="SourceList" x:Uid="SyncPage_SourceList" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:SyncSource">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox x:Uid="SyncPage_ActiveBox" Grid.Column="0" MinWidth="0" IsChecked="{x:Bind IsActive, Mode=TwoWay}"/>
                        <CheckBox x:Uid="SyncPage_SaveBox" Grid.Column="1" MinWidth="0" IsChecked="{x:Bind AllowSave, Mode=TwoWay}"/>
                        <TextBox x:Uid="SyncPage_NameBox" Grid.Column="2" Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox x:Uid="SyncPage_PrefixBox" Grid.Column="3" Text="{x:Bind ShortcutPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="Prefix_TextChanged"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Uid="SyncPage_MissingFileButton" Padding="4" Background="Transparent" BorderThickness="0"
                                    Visibility="{x:Bind IsFileMissing, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <FontIcon Glyph="&#xE7BA;" Foreground="#E6A700" FontSize="16"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="SyncPage_RecreateItem" Tag="{x:Bind}" Click="Recreate_Click"/>
                                        <MenuFlyoutItem x:Uid="SyncPage_RelinkItem" Tag="{x:Bind}" Click="Relink_Click"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <FontIcon Glyph="&#xE7BA;" Foreground="#E6A700" FontSize="16"
                                      Visibility="{x:Bind HasWriteProblem, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                      AutomationProperties.Name="{x:Bind WriteProblem, Mode=OneWay}"
                                      ToolTipService.ToolTip="{x:Bind WriteProblem, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind Path, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Uid="SyncPage_MoveUpButton" Click="MoveUp_Click" Padding="6"
                                    IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}">
                                <FontIcon Glyph="&#xE70E;" FontSize="14"/>
                            </Button>
                            <Button x:Uid="SyncPage_MoveDownButton" Click="MoveDown_Click" Padding="6"
                                    IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}">
                                <FontIcon Glyph="&#xE70D;" FontSize="14"/>
                            </Button>
                            <Button x:Uid="SyncPage_RemoveButton" Click="Remove_Click" Padding="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
