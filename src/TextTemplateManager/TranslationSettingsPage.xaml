<Page
    x:Class="TextTemplateManager.TranslationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextTemplateManager">

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Uid="TranslationPage_Title" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Uid="TranslationPage_ExperimentalBadge" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Uid="TranslationPage_CheckInfo" IsOpen="True" IsClosable="False" Severity="Warning"/>
            <TextBlock x:Uid="TranslationPage_IntroText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Uid="TranslationPage_ModelsText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <CheckBox x:Name="AutoCheckBox" x:Uid="TranslationPage_AutoCheckBox"
                      Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed"/>
            <CheckBox x:Name="AutoInstallBox" x:Uid="TranslationPage_AutoInstallBox" Margin="28,-6,0,0"
                      Checked="AutoInstall_Changed" Unchecked="AutoInstall_Changed"/>
            <Button x:Name="UpdateAllButton" x:Uid="TranslationPage_UpdateAllButton" Click="UpdateAll_Click" IsEnabled="False"/>
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="Info" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" x:Uid="TranslationPage_RetryButton" Click="Retry_Click" Visibility="Collapsed"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" x:Uid="TranslationPage_FilterBox" TextChanged="FilterBox_TextChanged"/>
            <ProgressRing Grid.Column="1" x:Name="CatalogProgress" IsActive="False" Width="20" Height="20"/>
            <TextBlock Grid.Column="2" x:Name="CatalogStatus" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <ListView Grid.Row="4" x:Name="LanguageList" x:Uid="TranslationPage_LanguageList" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TranslationLanguageRow">
                    <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}"/>
                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Margin="0,4,0,0"
                                         Visibility="{x:Bind BusyVisibility, Mode=OneWay}"
                                         AutomationProperties.Name="{x:Bind ProgressName}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Uid="TranslationPage_RowDownloadButton" Tag="{x:Bind}" Click="Download_Click" Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind DownloadName}"/>
                            <Button x:Uid="TranslationPage_RowUpdateButton" Tag="{x:Bind}" Click="Download_Click" IsEnabled="{x:Bind UpdateEnabled, Mode=OneWay}"
                                    Visibility="{x:Bind UpdateVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind UpdateName}"/>
                            <Button x:Uid="TranslationPage_RowRemoveButton" Tag="{x:Bind}" Click="Remove_Click"
                                    Visibility="{x:Bind RemoveVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind RemoveName}"/>
                            <Button x:Uid="TranslationPage_RowCancelButton" Tag="{x:Bind}" Click="Cancel_Click"
                                    Visibility="{x:Bind BusyVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind CancelName}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="5" Spacing="8">
            <TextBlock x:Name="DiskUsage" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Uid="TranslationPage_OfflineText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ExportButton" x:Uid="TranslationPage_ExportButton" Click="Export_Click"/>
                <Button x:Uid="TranslationPage_ImportButton" Click="Import_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
