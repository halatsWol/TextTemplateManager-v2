<Page
    x:Class="TextTemplateManager.TranslationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextTemplateManager">

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Translation" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Experimental" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Check every translation"
                     Message="Machine translation makes mistakes: it can change the meaning, drop words or put formatting on the wrong words. German can mix the formal (Sie) and informal (du) form: rarely with Formal on, often with it off (informal is best effort)."/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Translate templates in the editor (the Translate button at the end of its toolbar). The translation runs on this PC: download a language once, and from then on translating works offline and nothing you translate leaves the PC. Each language translates to and from English; other pairs, such as German to French, go through English and need both languages."/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="The languages are Firefox Translations models from Mozilla, downloaded from Mozilla's servers (Mozilla Public License 2.0)."/>
            <CheckBox x:Name="AutoCheckBox" Content="Check for newer versions of the installed languages once a day"
                      Checked="AutoCheck_Changed" Unchecked="AutoCheck_Changed"/>
            <CheckBox x:Name="AutoInstallBox" Content="Download them automatically" Margin="28,-6,0,0"
                      Checked="AutoInstall_Changed" Unchecked="AutoInstall_Changed"/>
            <Button x:Name="UpdateAllButton" Content="Download all updates" Click="UpdateAll_Click" IsEnabled="False"/>
        </StackPanel>

        <InfoBar Grid.Row="2" x:Name="Info" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" Content="Try again" Click="Retry_Click" Visibility="Collapsed"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" PlaceholderText="Search languages" TextChanged="FilterBox_TextChanged"
                     AutomationProperties.Name="Search languages"/>
            <ProgressRing Grid.Column="1" x:Name="CatalogProgress" IsActive="False" Width="20" Height="20"/>
            <TextBlock Grid.Column="2" x:Name="CatalogStatus" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <ListView Grid.Row="4" x:Name="LanguageList" SelectionMode="None" AutomationProperties.Name="Languages">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TranslationLanguageRow">
                    <Grid Padding="0,6" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}"/>
                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Margin="0,4,0,0"
                                         Visibility="{x:Bind BusyVisibility, Mode=OneWay}"
                                         AutomationProperties.Name="{x:Bind ProgressName}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Download" Tag="{x:Bind}" Click="Download_Click" Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind DownloadName}"/>
                            <Button Content="Update" Tag="{x:Bind}" Click="Download_Click" IsEnabled="{x:Bind UpdateEnabled, Mode=OneWay}"
                                    Visibility="{x:Bind UpdateVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind UpdateName}"/>
                            <Button Content="Remove" Tag="{x:Bind}" Click="Remove_Click"
                                    Visibility="{x:Bind RemoveVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind RemoveName}"/>
                            <Button Content="Cancel" Tag="{x:Bind}" Click="Cancel_Click"
                                    Visibility="{x:Bind BusyVisibility, Mode=OneWay}" AutomationProperties.Name="{x:Bind CancelName}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="5" Spacing="8">
            <TextBlock x:Name="DiskUsage" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="No internet access on this PC? Export the installed languages on another PC with TextTemplateManager and import the file here."/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ExportButton" Content="Export installed languages…" Click="Export_Click"/>
                <Button Content="Import languages…" Click="Import_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
