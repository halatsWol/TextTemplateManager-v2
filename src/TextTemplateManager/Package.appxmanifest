<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop uap5 rescap">

  <!-- Identity as reserved in Partner Center. Version is replaced by the build (git tag, X.Y.Z.0). -->
  <Identity
    Name="MarflowSoftware.TextTemplateManager"
    Publisher="CN=C9F7C26C-4850-43E6-87E5-E4CE09305DCD"
    Version="2.0.0.0" />

  <Properties>
    <DisplayName>TextTemplateManager</DisplayName>
    <PublisherDisplayName>Marflow Software</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- The build adds the Windows App Runtime dependency (framework-dependent Windows App SDK) and sets
       MaxVersionTested from the target framework's Windows version. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="TextTemplateManager"
        Description="Text templates for everyday writing: organize them in folders, share them through synced files, and paste them anywhere with a global hotkey."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\SmallTile.png" Square310x310Logo="Assets\LargeTile.png"/>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Start with Windows: on from the first launch (no prompt for a packaged desktop app). The user can
             switch it off in the app, in Windows Settings › Apps › Startup or in Task Manager. -->
        <desktop:Extension Category="windows.startupTask">
          <desktop:StartupTask TaskId="TtmStartup" Enabled="true" DisplayName="TextTemplateManager" />
        </desktop:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="ttmdata">
            <uap:DisplayName>TextTemplateManager data</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.ttmdata</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- 1.x shipped as ttm.exe, so Start search found the app by "ttm"; the aliases bring that back
             (Start matches them whole, not by prefix). With web search on, Start didn't offer the one with
             spaces (Win 11 24H2); kept for setups without web search. -->
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="ttm.exe" />
            <uap5:ExecutionAlias Alias="ttm2.exe" />
            <uap5:ExecutionAlias Alias="text template manager.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
