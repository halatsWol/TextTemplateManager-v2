<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Lets GitHub's dependency submission restore on Linux; no effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TextTemplateManager</RootNamespace>
    <!-- Ship the executable as ttm2.exe (independent of the .csproj / namespace name); 1.x is ttm.exe. -->
    <AssemblyName>ttm2</AssemblyName>
    <!-- Local/dev default. A release build passes the git tag as -p:Version=X.Y.Z, which also becomes
         the package version (StampPackageVersion below). -->
    <Version>0.0.0-dev</Version>
    <!-- Release date (yyyy-MM-dd), passed by a release build as -p:ReleaseDate=...; empty for local/dev
         builds (About then shows "dev build"). Baked into an assembly-metadata attribute below. -->
    <ReleaseDate></ReleaseDate>
    <!-- Keep InformationalVersion clean (no +<git-hash>) so the About dialog shows just the version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Marflow Software</Company>
    <Product>TextTemplateManager</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp'">win-x64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <!-- C# 14 (.NET 10 SDK): [ObservableProperty] partial properties with initializers, declared in
         source so the System.Text.Json source generator sees them. -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKTargetsSelfContained>true</WindowsAppSDKTargetsSelfContained>
    <!-- Dev builds and test runs are unpackaged; only the Store build (below) makes an MSIX. Unpackaged is
         what pulls in the *bootstrap* initializer: without it an unpackaged run gets only the
         DeploymentManager initializer, which then fails with REGDB_E_CLASSNOTREG before the window
         appears. Requires the Unpackaged launch profile (see Properties/launchSettings.json) — the
         MsixPackage profile cannot deploy an unpackaged build. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!-- Store package (x64 bundle and .msixupload in AppPackages\), from a short path because the
       XAML compiler fails silently near 260 characters:
         dotnet build -c Release -p:Platform=x64 -p:StoreBuild=true -p:Version=X.Y.Z -p:ReleaseDate=yyyy-MM-dd
       .NET stays self-contained (the Store has no framework package for it); the Windows App SDK becomes a
       framework dependency the Store installs and services. Unsigned: the Store signs it. -->
  <PropertyGroup Condition="'$(StoreBuild)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSDKTargetsSelfContained>false</WindowsAppSDKTargetsSelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <UapAppxPackageBuildMode>StoreUpload</UapAppxPackageBuildMode>
    <AppxBundle>Always</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
  </PropertyGroup>

  <!-- The package version comes from the manifest's Identity; a release build stamps -p:Version=X.Y.Z
       into a copy as X.Y.Z.0 (the Store needs the fourth field to be 0). Dev builds keep the manifest's. -->
  <Target Name="StampPackageVersion" BeforeTargets="BeforeBuild"
          Condition="'$(WindowsPackageType)' == 'MSIX' and !$(Version.Contains('-'))">
    <PropertyGroup>
      <StampedManifest>$(IntermediateOutputPath)Package.appxmanifest</StampedManifest>
    </PropertyGroup>
    <Copy SourceFiles="Package.appxmanifest" DestinationFiles="$(StampedManifest)" />
    <XmlPoke XmlInputPath="$(StampedManifest)" Query="/m:Package/m:Identity/@Version" Value="$(Version).0"
             Namespaces="&lt;Namespace Prefix='m' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(StampedManifest)" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <!-- Trimming breaks reflection-based System.Text.Json (data files fail to load) and CsWinRT
         marshalling, so it stays off until both are trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Bake the release date into an assembly-metadata attribute the About dialog reads. -->
  <ItemGroup Condition="'$(ReleaseDate)' != ''">
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TextTemplateManager.Tests" />
  </ItemGroup>

  <!-- Everything under Assets ships next to the exe, except the manual's source screenshots.
       The SDK's default items are removed first so each file is listed exactly once. -->
  <ItemGroup>
    <Content Remove="Assets\**" />
    <None Remove="Assets\**" />
    <Content Include="Assets\**" Exclude="Assets\ManualImages\**;Assets\Manual.pdf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Generated from docs/user/Manual.md (target below); Link puts it at the output root. -->
    <Content Include="Assets\Manual.pdf" Link="Manual.pdf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Help ▸ About displays the LICENSE. -->
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <!-- What's new after an update shows the release notes' "What's new" section. -->
    <Content Include="..\..\release.md" Link="release.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Regenerate the manual when the markdown changes. ContinueOnError keeps the app build
       working offline / if the tool can't restore — the last generated PDF is used then. -->
  <Target Name="GenerateManual" BeforeTargets="BeforeBuild"
          Inputs="..\..\docs\user\Manual.md;Assets\ManualImages\**\*" Outputs="Assets\Manual.pdf">
    <Exec ContinueOnError="true"
          Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\..\tools\ManualGen\ManualGen.csproj&quot; -c Release -- &quot;$(MSBuildProjectDirectory)\..\..\docs\user\Manual.md&quot; &quot;$(MSBuildProjectDirectory)\Assets\Manual.pdf&quot; &quot;$(Version)&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7463" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260101001" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
  </ItemGroup>

  <!-- Let Visual Studio's single-project MSIX tooling (capability, Package and Publish menu) light up
       even before the Windows App SDK package is restored. -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
