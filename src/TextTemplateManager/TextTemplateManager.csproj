<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TextTemplateManager</RootNamespace>
    <!-- Ship the executable as ttm.exe (independent of the .csproj / namespace name). -->
    <AssemblyName>ttm</AssemblyName>
    <!-- Local/dev default. Release builds override it from the git tag via -p:Version=X.Y.Z
         (see package.ps1 and .github/workflows/release.yml). -->
    <Version>0.0.0-dev</Version>
    <!-- Release date (yyyy-MM-dd), stamped by package.ps1 / CI via -p:ReleaseDate=...; empty for
         local/dev builds (About then shows "dev build"). Baked into an assembly-metadata attribute below. -->
    <ReleaseDate></ReleaseDate>
    <!-- Keep InformationalVersion clean (no +<git-hash>) so the About dialog shows just the version. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Marflow Software</Company>
    <Product>Text Template Manager</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETCoreApp'">win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <!-- C# 14 (.NET 10 SDK): [ObservableProperty] partial properties with initializers, declared in
         source so the System.Text.Json source generator sees them. -->
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKTargetsSelfContained>true</WindowsAppSDKTargetsSelfContained>
    <!-- The app only ever ships unpackaged (per-user Inno installer, never MSIX) and package.ps1 already
         publishes with this; setting it here makes F5 match. It is what pulls in the *bootstrap*
         initializer: without it an unpackaged run gets only the DeploymentManager initializer, which then
         fails with REGDB_E_CLASSNOTREG before the window appears. Requires the Unpackaged launch profile
         (see Properties/launchSettings.json) — the MsixPackage profile cannot deploy an unpackaged build. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">true</PublishReadyToRun>
    <!-- Trimming breaks reflection-based System.Text.Json (data files fail to load) and CsWinRT
         marshalling, so it stays off until both are trim-safe. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Bake the release date into an assembly-metadata attribute the About dialog reads. -->
  <ItemGroup Condition="'$(ReleaseDate)' != ''">
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TextTemplateManager.Tests" />
  </ItemGroup>

  <!-- Everything under Assets ships next to the exe, except the manual's source screenshots.
       The SDK's default items are removed first so each file is listed exactly once. -->
  <ItemGroup>
    <Content Remove="Assets\**" />
    <None Remove="Assets\**" />
    <Content Include="Assets\**" Exclude="Assets\ManualImages\**;Assets\Manual.pdf;Assets\editor\editor.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- Generated from docs/user/Manual.md (target below); Link puts it at the output root. -->
    <Content Include="Assets\Manual.pdf" Link="Manual.pdf" CopyToOutputDirectory="PreserveNewest" />
    <!-- build.mjs only copies editor.html verbatim, so it isn't committed; take it from the editor
         sources so a fresh clone still gets an editor pane (MainPage reads all three files at init). -->
    <Content Include="..\editor\src\editor.html" Link="Assets\editor\editor.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- Help ▸ About displays the LICENSE. -->
    <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Regenerate the manual when the markdown changes. ContinueOnError keeps the app build
       working offline / if the tool can't restore — the last generated PDF is used then. -->
  <Target Name="GenerateManual" BeforeTargets="BeforeBuild"
          Inputs="..\..\docs\user\Manual.md;Assets\ManualImages\**\*" Outputs="Assets\Manual.pdf">
    <Exec ContinueOnError="true"
          Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\..\tools\ManualGen\ManualGen.csproj&quot; -c Release -- &quot;$(MSBuildProjectDirectory)\..\..\docs\user\Manual.md&quot; &quot;$(MSBuildProjectDirectory)\Assets\Manual.pdf&quot; &quot;$(Version)&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7463" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260101001" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
  </ItemGroup>

  <!-- Let Visual Studio's single-project MSIX tooling (capability, Package and Publish menu) light up
       even before the Windows App SDK package is restored. -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
