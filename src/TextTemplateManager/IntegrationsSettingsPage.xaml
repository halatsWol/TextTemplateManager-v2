<Page
    x:Class="TextTemplateManager.IntegrationsSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
    <StackPanel Spacing="25" Padding="20">
        <TextBlock x:Uid="IntegrationsPage_Title" Style="{StaticResource TitleTextBlockStyle}"/>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="IntegrationsPage_BrowserHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock x:Uid="IntegrationsPage_BrowserText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <ToggleSwitch x:Name="ConnectorToggle" x:Uid="IntegrationsPage_ConnectorToggle" Toggled="Connector_Toggled"/>

            <Grid x:Name="ConnectorDetails" Visibility="Collapsed" ColumnSpacing="10" RowSpacing="8" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Uid="IntegrationsPage_PortLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ConnectorPortBox" HorizontalAlignment="Left" MinWidth="90"
                         InputScope="Number" LostFocus="ConnectorPort_LostFocus"/>

                <TextBlock x:Uid="IntegrationsPage_TokenLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ConnectorTokenBox" IsReadOnly="True" IsSpellCheckEnabled="False"/>
                <Button x:Uid="IntegrationsPage_CopyTokenButton" Grid.Row="1" Grid.Column="2" Click="CopyToken_Click"/>
                <Button x:Uid="IntegrationsPage_RegenerateTokenButton" Grid.Row="1" Grid.Column="3" Click="RegenerateToken_Click"/>
            </Grid>
            <InfoBar x:Name="ConnectorUnavailableInfo" x:Uid="IntegrationsPage_ConnectorUnavailableInfo"
                     Severity="Warning"
                     IsClosable="False"
                     IsOpen="False"/>

            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Uid="IntegrationsPage_GetExtensionLabel" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <HyperlinkButton Content="Chrome" Padding="0"
                                 NavigateUri="https://chrome.google.com/webstore/detail/jclopjpjdldbknjdhmjldehlkgbihlmi"/>
                <HyperlinkButton Content="Edge" Padding="0"
                                 NavigateUri="https://microsoftedge.microsoft.com/addons/detail/ttm-connect/fbpmhopmnaoedcnbegdkpfblekhaindm"/>
                <HyperlinkButton Content="Firefox" Padding="0"
                                 NavigateUri="https://addons.mozilla.org/addon/ttm-connect/"/>
            </StackPanel>
            <HyperlinkButton x:Name="ApiDocLink" x:Uid="IntegrationsPage_ApiDocLink" Padding="0"/>
        </StackPanel>

        <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,5"/>

        <StackPanel Spacing="8">
            <TextBlock x:Uid="IntegrationsPage_FileAssociationHeading" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <TextBlock x:Uid="IntegrationsPage_FileAssociationText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <HyperlinkButton x:Uid="IntegrationsPage_DefaultAppsLink" Padding="0" Click="OpenDefaultApps_Click"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Page>
